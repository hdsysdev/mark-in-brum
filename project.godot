; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mark in Brum"
config/description="Darkly comic third-person sandbox: Mark explores a condensed Birmingham city centre and causes escalating civic chaos. Adult humour, non-explicit."
run/main_scene="res://scenes/bootstrap/bootstrap.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.05, 0.06, 0.08, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

GameEvents="*res://autoload/game_events.gd"
SaveManager="*res://autoload/save_manager.gd"
PlatformService="*res://autoload/platform_service.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
